Cell["\<\
(* ================================================================
   localInit.wl --- Mathematica \:8d77\:52d5\:6642\:306e\:30ed\:30fc\:30ab\
\:30eb\:8a2d\:5b9a
   \:914d\:7f6e: $UserBaseDirectory/Kernel/ (init.m \:3068\:540c\:3058\:30d5\
\:30a9\:30eb\:30c0)
   ================================================================ *)

$CharacterEncoding = \"UTF-8\";

(* --- \:30d1\:30c3\:30b1\:30fc\:30b8\:30c7\:30a3\:30ec\:30af\:30c8\:30ea\
\:ff08\:74b0\:5883\:306b\:5408\:308f\:305b\:308b\:ff09 --- *)
$packageDirectory = FileNameJoin[{\"F:\", \"Dropbox\", \"Mathematica-oneDrive\
\", \"MyPackages\"}];
If[FreeQ[$Path, $packageDirectory], AppendTo[$Path, $packageDirectory]];


(* --- \:30d1\:30c3\:30b1\:30fc\:30b8\:30ed\:30fc\:30c9\:ff08\:3053\:306e\
\:9806\:5e8f\:3092\:5b88\:308b\:ff09 --- *)
<<NBAccess.wl
Needs[\"NotebookExtensions`\", \"NotebookExtensions.wl\"];
Needs[\"ClaudeCode`\", \"claudecode.wl\"];
Needs[\"ClaudeRuntime`\", \"ClaudeRuntime.wl\"];
Needs[\"ClaudeOrchestrator`\", \"ClaudeOrchestrator.wl\"];

(* --- \:6697\:53f7\:9375 backend: SourceVault \:30ed\:30fc\:30c9\:3088\:308a\
\:524d\:306b\:5fc5\:305a\:8a2d\:5b9a\:ff08\:6700\:91cd\:8981\:ff09 --- *)
NBAccess`$NBCredentialBackend = \"SystemCredential\";

Needs[\"SourceVault`\", \"SourceVault.wl\"];
(* \:4efb\:610f: Eagle \:9023\:643a\:306f\:81ea\:52d5\:30ed\:30fc\:30c9\:3055\
\:308c\:306a\:3044\:3002\:4f7f\:3046\:5834\:5408\:306e\:307f *)
(* <<SourceVault_eagle.wl *)
<<github.wl

(* --- \:30ed\:30fc\:30c9\:5f8c\:306e\:8a2d\:5b9a --- *)
$GitHubLicenseHolder = \"Your Name\";

(* \:30af\:30e9\:30a6\:30c9\:5074\:30e2\:30c7\:30eb\:ff08\:65e2\:5b9a\:306b\
\:4efb\:305b\:308b\:306a\:3089\:7701\:7565\:53ef\:ff09 *)
$ClaudeModel = ClaudeCode`GetModelOpus[];

(* \:30ed\:30fc\:30ab\:30eb LLM (LM Studio): {provider, \:30e2\:30c7\:30eb\
\:540d, URL} *)
$ClaudePrivateModel = {\"lmstudio\", \"qwen/qwen3.6-27b\", \
\"http://127.0.0.1:1234\"};

(* \:4fe1\:983c\:30ed\:30fc\:30ab\:30eb\:30b5\:30fc\:30d0\:767b\:9332 \
(NBAccess): \
\:6a5f\:5bc6\:30c7\:30fc\:30bf\:3092\:9001\:3063\:3066\:3088\:3044\:30ed\:30fc\
\:30ab\:30eb LLM \:3092\:5ba3\:8a00 *)
NBAccess`NBRegisterTrustedLocalServer[<|\"MachineName\" -> $MachineName,
  \"Provider\" -> \"lmstudio\", \"URL\" -> \"http://127.0.0.1:1234\"|>];

(* \:30e2\:30c7\:30eb\:5909\:6570\:306e\:540c\:671f *)
NBAccess`NBSyncClaudeModelVars[];\
\>", "Input",
 CellChangeTimes->{{3.9955221261506863`*^9, 

Cell["\<\
Dataset @ <|
  \"CredentialBackend (= SystemCredential)\" -> \
NBAccess`$NBCredentialBackend,
  \"ClaudeRuntime version\"       -> ClaudeRuntime`$ClaudeRuntimeVersion,
  \"UseClaudeRuntime (= True)\"   -> ClaudeCode`$UseClaudeRuntime,
  \"ClaudeOrchestrator version\"  -> \
ClaudeOrchestrator`$ClaudeOrchestratorVersion,
  \"Workflow version\"            -> \
ClaudeOrchestrator`Workflow`$WorkflowVersion,
  \"SourceVault roots OK\"        -> \
AssociationQ[SourceVault`$SourceVaultRoots],
  \"\:6697\:53f7\:9375 \:521d\:671f\:5316\:6e08\:307f\"           -> \
MatchQ[SourceVault`SourceVaultInitializeEncryption[\"DryRun\" -> \
True][\"MissingKeyRefs\"], {}],
  \"\:9375\:30d0\:30f3\:30c9\:30eb\:5b58\:5728\"              -> \
FileExistsQ[SourceVault`$SourceVaultKeyBundleDefaultPath],
  \"GITHUB_TOKEN \:8a2d\:5b9a\:6e08\:307f\"       -> \
NBAccess`NBCredentialConfiguredQ[\"GITHUB_TOKEN\"],
  \"\:5b9fLLM\:7d4c\:8def (CLI)\"             -> \
ClaudeOrchestrator`ClaudeRealLLMAvailable[]
|>\
\>", "Input",ExpressionUUID->"4a65cc0a-93c2-c146-a312-0884b563d5a0"],

